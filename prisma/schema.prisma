generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum IdeaStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AssetStatus {
  UPLOADED
  APPROVED
  NEEDS_REVISION
  APPROVED_ANYWAY
}

enum ValidationResult {
  APPROVED
  NEEDS_REVISION
}

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  APPROVED
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum DailyReportStatus {
  PREPARING
  READY
  PUBLISHED
  FAILED
}

enum UsageMetric {
  AI_CALL
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  GEMINI_VIDEO_ANALYSIS
  VEO_GENERATION
  STORAGE_BYTES
  COMPETITOR_REQUEST
}

enum SceneVersionStatus {
  GENERATING
  READY
  APPROVED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPLIED
  IGNORED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channels  Channel[]
  aiConnections AIConnection[]
  usageEvents UsageEvent[]
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model AIConnection {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  kind         String
  label        String?
  encryptedKey String
  keyLast4     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id])
  @@unique([userId, provider, kind])
  @@index([userId, revokedAt])
}

model Channel {
  id                    String       @id @default(cuid())
  userId                String
  name                  String
  platform              String
  topic                 String
  subTopic              String?
  targetCountry         String
  language              String
  audience              String
  contentStyle          String
  visualStyle           String
  videoDurationSec      Int?
  hasDialogue           Boolean      @default(false)
  creativeInstructions  String?
  hashtags              String?
  mainCharacterImageKey String?
  mainCharacterImageName String?
  mainCharacterImageMimeType String?
  mustKeep              Json         @default("[]")
  mustAvoid             Json         @default("[]")
  timezone              String
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id])
  competitors           Competitor[]
  reports               DailyReport[]
  projects              ContentProject[]
  usageEvents           UsageEvent[]
  @@index([userId, status])
}

model Competitor {
  id            String       @id @default(cuid())
  channelId     String
  platform      String
  url           String
  externalId    String
  handle        String
  normalizedUrl String
  displayName   String?
  avatar        String?
  status        RecordStatus @default(ACTIVE)
  lastSyncedAt  DateTime?
  syncError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  channel       Channel      @relation(fields: [channelId], references: [id])
  videos        CompetitorVideo[]
  baselines     CompetitorBaseline[]
  @@unique([channelId, normalizedUrl])
}

model CompetitorVideo {
  id            String           @id @default(cuid())
  competitorId  String
  externalId    String
  url           String
  title         String?
  caption       String?
  thumbnailUrl  String?
  publishedAt   DateTime?
  duration      Int?
  firstSeenAt   DateTime         @default(now())
  lastSeenAt    DateTime         @default(now())
  competitor    Competitor       @relation(fields: [competitorId], references: [id])
  snapshots     VideoMetricSnapshot[]
  analyses      SourceAnalysis[]
  reportItems   ReportItem[]
  @@unique([competitorId, externalId])
}

model VideoMetricSnapshot {
  id           String     @id @default(cuid())
  videoId      String
  capturedAt   DateTime
  views        Int        @default(0)
  likes        Int        @default(0)
  comments     Int        @default(0)
  shares       Int        @default(0)
  rawMetrics   Json?
  video        CompetitorVideo @relation(fields: [videoId], references: [id])
  @@unique([videoId, capturedAt])
  @@index([videoId, capturedAt(sort: Desc)])
}

model CompetitorBaseline {
  id             String     @id @default(cuid())
  competitorId   String
  windowDays     Int
  sampleSize     Int
  viewsP50       Float
  viewsP75       Float
  viewsP90       Float
  engagementRate Float
  calculatedAt   DateTime   @default(now())
  competitor     Competitor @relation(fields: [competitorId], references: [id])
  @@unique([competitorId, windowDays, calculatedAt])
}

model DailyReport {
  id          String       @id @default(cuid())
  channelId   String
  localDate   DateTime
  periodStart DateTime
  periodEnd   DateTime
  timezone    String
  status      DailyReportStatus @default(PREPARING)
  generatedAt DateTime?
  publishedAt DateTime?
  channel     Channel      @relation(fields: [channelId], references: [id])
  items       ReportItem[]
  @@unique([channelId, localDate])
}

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  reportId  String
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt(sort: Desc)])
}

model ReportItem {
  id                  String      @id @default(cuid())
  reportId            String
  sourceVideoId       String
  viralScore          Float
  relativePerformance Float
  analysisSummary     String?
  modelingMechanism   String?
  rank                Int
  report              DailyReport @relation(fields: [reportId], references: [id])
  sourceVideo         CompetitorVideo @relation(fields: [sourceVideoId], references: [id])
  @@unique([reportId, sourceVideoId])
}

model SourceAnalysis {
  id                    String     @id @default(cuid())
  sourceVideoId         String
  version               Int
  provider              String
  schemaVersion         String
  content               Json
  rawOutput             Json?
  createdAt             DateTime   @default(now())
  sourceVideo           CompetitorVideo @relation(fields: [sourceVideoId], references: [id])
  ideas                 ModelingIdea[]
  @@unique([sourceVideoId, version])
}

model ModelingIdea {
  id              String        @id @default(cuid())
  sourceVideoId   String
  analysisId      String
  title           String
  content         Json
  status          IdeaStatus    @default(DRAFT)
  saved           Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  analysis        SourceAnalysis @relation(fields: [analysisId], references: [id])
  project         ContentProject?
}

model ContentProject {
  id             String             @id @default(cuid())
  channelId      String
  ideaId         String             @unique
  status         String
  deconstruction Json?
  artDirection   Json?
  characterDesign Json?
  backgroundDesign Json?
  storyboard      Json?
  safetyReview   Json?
  productionPrompts Json?
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  channel        Channel            @relation(fields: [channelId], references: [id])
  idea           ModelingIdea      @relation(fields: [ideaId], references: [id])
  scenes         StoryboardScene[]
  assets         Asset[]
  reviews        ProjectReview[]
  usageEvents    UsageEvent[]
}

model UsageEvent {
  idempotencyKey String      @id
  userId         String
  channelId      String?
  projectId      String?
  metric         UsageMetric
  quantity       Float       @default(1)
  inputTokens    Int?
  outputTokens   Int?
  bytes          BigInt?
  usageDate      DateTime
  metadata       Json?
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id])
  channel        Channel?    @relation(fields: [channelId], references: [id])
  project        ContentProject? @relation(fields: [projectId], references: [id])
  @@index([userId, usageDate])
  @@index([userId, metric, usageDate])
  @@index([channelId, usageDate])
  @@index([projectId, usageDate])
}

model ProjectReview {
  id                String       @id @default(cuid())
  projectId         String
  version           Int
  provider          String
  status            ReviewStatus @default(PENDING)
  issues            Json
  originalSnapshot  Json
  decisionNote      String?
  selectedIssueIds  Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           ContentProject @relation(fields: [projectId], references: [id])
  @@unique([projectId, version])
}

model StoryboardScene {
  id             String           @id @default(cuid())
  projectId      String
  sceneNumber    Int
  visualBlock    String
  actionBlock    String
  audioBlock     String
  englishPrompt  String?
  startFramePrompt String?
  promptProvider String?
  status         String
  project        ContentProject   @relation(fields: [projectId], references: [id])
  assets         SceneAsset[]
  generations    VideoGeneration[]
  generationJobs VideoGenerationJob[]
  versions       SceneGenerationVersion[]
  @@unique([projectId, sceneNumber])
}

model Asset {
  id          String          @id @default(cuid())
  projectId   String
  type        String
  name        String
  storageKey  String
  characterId String?
  backgroundId String?
  sceneIds    Json            @default("[]")
  version     Int             @default(1)
  mimeType    String
  checksum    String
  metadata    Json?
  status      AssetStatus     @default(UPLOADED)
  project     ContentProject  @relation(fields: [projectId], references: [id])
  validations AssetValidation[]
  scenes      SceneAsset[]
  @@unique([projectId, name, version])
  @@index([projectId, type, status])
}

model AssetValidation {
  id        String           @id @default(cuid())
  assetId   String
  result    ValidationResult
  issues    Json?
  provider  String
  version   Int
  createdAt DateTime         @default(now())
  asset     Asset            @relation(fields: [assetId], references: [id])
  @@unique([assetId, version])
}

model SceneAsset {
  sceneId String
  assetId String
  scene   StoryboardScene @relation(fields: [sceneId], references: [id])
  asset   Asset           @relation(fields: [assetId], references: [id])
  @@id([sceneId, assetId])
}

model VideoGeneration {
  id             String           @id @default(cuid())
  sceneId        String
  provider       String
  version        Int
  promptSnapshot String
  assetSnapshot  Json
  externalJobId  String?
  status         GenerationStatus @default(QUEUED)
  previewUrl     String?
  error          String?
  createdBy      String
  createdAt      DateTime         @default(now())
  scene          StoryboardScene  @relation(fields: [sceneId], references: [id])
  @@unique([sceneId, version])
}

model VideoGenerationJob {
  id                   String             @id @default(cuid())
  sceneId              String
  provider             String
  status               GenerationJobStatus @default(QUEUED)
  externalOperationId  String?
  prompt               String
  error                String?
  startedAt            DateTime?
  completedAt          DateTime?
  resultUrl            String?
  createdAt            DateTime           @default(now())
  scene                StoryboardScene    @relation(fields: [sceneId], references: [id])
  version              SceneGenerationVersion?
  @@index([sceneId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model SceneGenerationVersion {
  id              String             @id @default(cuid())
  sceneId         String
  version         Int
  generationJobId String             @unique
  prompt          String
  provider        String
  status          SceneVersionStatus @default(GENERATING)
  previewUrl      String?
  matchScore      Int?
  storyboardMatch Int?
  characterMatch  Int?
  backgroundMatch Int?
  actionMatch     Int?
  cameraMatch     Int?
  reviewNotes     Json?
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
  scene           StoryboardScene    @relation(fields: [sceneId], references: [id])
  generationJob   VideoGenerationJob @relation(fields: [generationJobId], references: [id])
  @@unique([sceneId, version])
  @@index([sceneId, createdAt(sort: Desc)])
}

model BackgroundJob {
  id             String   @id @default(cuid())
  name           String
  payload        Json
  idempotencyKey String   @unique
  status         String   @default("queued")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  @@index([status, createdAt])
}

model SyncRun {
  id                String   @id
  userId            String
  status            String   @default("running")
  total             Int      @default(0)
  processed         Int      @default(0)
  failed            Int      @default(0)
  remainingChannels Int      @default(0)
  error             String?
  startedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?
  @@index([userId, startedAt])
}

model AutomationRun {
  id            String   @id @default(cuid())
  userId        String
  sourceVideoId String
  ideaId        String?
  projectId     String?
  status        String   @default("RUNNING")
  settings      Json
  steps         Json
  error         String?
  startedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  @@index([userId, startedAt])
}

model CodexJob {
  id                 String   @id @default(cuid())
  userId             String
  channelId          String
  sourceVideoId      String
  contentProjectId   String?
  automationRunId    String?
  idempotencyKey     String   @unique
  sessionId          String   @unique
  previousResponseId String?
  status             String   @default("PLANNING")
  currentStage       String   @default("PLAN")
  currentAction      String?
  retryCount         Int      @default(0)
  checkpoint         Json     @default("{}")
  finalVideoId       String?
  finalVideoPath     String?
  finalVideoUrl      String?
  failureReason      String?
  startedAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  completedAt        DateTime?
  stages             CodexStageState[]
  events             CodexEvent[]
  experiences        AgentExperience[]
  improvements       AppImprovementCandidate[]
  runtimeFailures    RuntimeFailure[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([sourceVideoId, status])
}

model RuntimeFailure {
  id               String   @id @default(cuid())
  userId           String?
  codexJobId       String?
  backgroundJobId  String?
  source           String
  stage            String?
  failureKind      String   @default("TECHNICAL_FAILURE")
  code             String
  message          String
  stack            String?
  context          Json     @default("{}")
  status           String   @default("PENDING")
  attempts         Int      @default(0)
  codexResponseId  String?
  lastAttemptAt    DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  codexJob         CodexJob? @relation(fields: [codexJobId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([codexJobId, createdAt])
  @@index([backgroundJobId, createdAt])
}

model CodexStageState {
  id                 String   @id @default(cuid())
  jobId              String
  stage              String
  status             String   @default("PENDING")
  expectedState      Json?
  actualState        Json?
  validationResult   String?
  validationIssues   Json?
  retryCount         Int      @default(0)
  maxRetries         Int      @default(3)
  lastErrorSignature String?
  lastStrategy       String?
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime @updatedAt
  job                CodexJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stage])
  @@index([jobId, status])
}

model CodexEvent {
  id               String   @id @default(cuid())
  jobId            String
  sequence         Int
  type             String
  stage            String?
  level            String   @default("INFO")
  payload          Json     @default("{}")
  reasoningSummary String?
  createdAt        DateTime @default(now())
  job              CodexJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
  @@index([type, createdAt])
}

model AgentExperience {
  id             String    @id @default(cuid())
  jobId          String?
  stage          String
  provider       String?
  errorSignature String
  errorMessage   String?
  expectedState  Json?
  actualState    Json?
  rootCause      String?
  attemptedFix   String?
  successfulFix  String?
  result         String
  occurrenceCount Int      @default(1)
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  job            CodexJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([stage, provider, errorSignature])
  @@index([result, lastSeenAt])
}

model AppImprovementCandidate {
  id                   String    @id @default(cuid())
  jobId                String?
  title                String
  category             String
  affectedModule       String
  evidence             Json
  relatedJobs          Json      @default("[]")
  occurrenceCount      Int       @default(1)
  rootCause            String
  currentBehavior      String
  desiredBehavior      String
  proposedFix          String
  externalReferences   Json      @default("[]")
  alternativeSolutions Json      @default("[]")
  riskLevel            String
  expectedBenefit      String
  requiredTests        Json      @default("[]")
  migrationImpact      String
  status               String    @default("PROPOSED")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  job                  CodexJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([affectedModule, category])
}
