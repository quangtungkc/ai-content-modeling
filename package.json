{
  "name": "ai-content-modeling",
  "version": "1.0.25",
  "private": true,
  "description": "Desktop AI content modeling pipeline with CDP-controlled Gemini and Flow workflows",
  "author": "Quang Tung",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-with-lock.cjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:build-contention": "vitest run scripts/build-lock.test.ts --reporter=dot",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/workers/worker.ts",
    "scheduler": "tsx src/workers/scheduler.ts",
    "report-scheduler": "tsx src/workers/report-scheduler.ts",
    "production:validate:resume": "node scripts/production-validation/cdp-resume-validation.mjs",
    "dev:local": "node scripts/recovery-desktop-runtime.mjs",
    "recovery:desktop": "npm run dev:local",
    "nest:dev": "tsx src/nest/main.ts",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run nest:dev\" \"wait-on http://localhost:3000 && electron electron/main.cjs\"",
    "electron:prepare": "npm run build && node electron/prepare-desktop.mjs",
    "electron:build": "npm run electron:prepare && electron-builder",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^6.15.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "5.3.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "vn.sabretn.ai-content-modeling",
    "productName": "Modeling AI",
    "artifactName": "Modeling.AI.Setup.${version}.${ext}",
    "directories": {
      "output": "release/1.0.25-production"
    },
    "files": [
      "electron/main.cjs",
      "electron/facebook-video-date.cjs",
      "electron/facebook-source-selection.cjs",
      "electron/user-data.cjs",
      "electron/sqlite-release-schema.cjs",
      "electron/edge-gemini-cdp.cjs",
      "electron/gemini-edge-file-chooser.cjs",
      "electron/gemini-browser-lifecycle.cjs",
      "electron/gemini-conversation-lifecycle.cjs",
      "electron/gemini-remote-script.cjs",
      "electron/gemini-error-transport.cjs",
      "electron/modeling-safety-policy.cjs",
      "electron/content-project-response.cjs",
      "electron/temp-cleanup.cjs",
      "electron/final-video-validation.cjs",
      "electron/ipc-contract.cjs",
      "electron/dev-runtime-identity.cjs",
      "electron/preload.cjs",
      "electron/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "quangtungkc",
      "repo": "ai-content-modeling"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
