{
  "name": "ai-content-modeling",
  "version": "0.2.74",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/workers/worker.ts",
    "scheduler": "tsx src/workers/scheduler.ts",
    "report-scheduler": "tsx src/workers/report-scheduler.ts",
    "nest:dev": "tsx src/nest/main.ts",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run nest:dev\" \"wait-on http://localhost:3000 && electron electron/main.cjs\"",
    "electron:prepare": "npm run build && node electron/prepare-desktop.mjs",
    "electron:build": "npm run electron:prepare && electron-builder",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^6.15.0",
    "electron-updater": "^6.8.9",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "vn.sabretn.ai-content-modeling",
    "productName": "Modeling AI",
    "artifactName": "Modeling.AI.Setup.${version}.${ext}",
    "directories": {
      "output": "release2"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "quangtungkc",
      "repo": "ai-content-modeling"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
