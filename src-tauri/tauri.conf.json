{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Content Modeling",
  "version": "0.1.0",
  "identifier": "com.phong.aicontentmodeling",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
